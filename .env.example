# Copy to .env and fill in. Never commit the real .env file.

# Where SQLite data lives (defaults to backend/data)
APP_DATA_DIR=./backend/data

# --- MyAudi automatic integration (optional, off by default) ---
# See backend/app/integrations/myaudi_source.py before turning this on:
# it depends on the unofficial, community-maintained `audiconnectpy`
# package and Audi's backend can and does break it without notice.
MYAUDI_AUTO_ENABLED=false
MYAUDI_USERNAME=
MYAUDI_PASSWORD=
MYAUDI_SPIN=
MYAUDI_MIN_POLL_INTERVAL_SECONDS=900
