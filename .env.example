# Copy to .env and fill in. Never commit the real .env file.

# Where SQLite data lives (defaults to backend/data)
APP_DATA_DIR=./backend/data

# --- MyAudi automatic integration (optional, off by default) ---
# See backend/app/integrations/myaudi_source.py before turning this on:
# it depends on the unofficial, community-maintained `carconnectivity` +
# `carconnectivity-connector-audi` packages, and Audi's backend can and
# does break this without notice.
MYAUDI_AUTO_ENABLED=false
MYAUDI_USERNAME=
MYAUDI_PASSWORD=
# Only needed for vehicle commands (lock/climate/etc.), not for reading
# charge status — leave blank unless you know you need it.
MYAUDI_SPIN=
# Seconds between polls. The Audi connector enforces a 180s floor itself.
MYAUDI_MIN_POLL_INTERVAL_SECONDS=300
